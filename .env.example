# Variables d'environnement — Application Archive
# =====================================================
# IMPORTANT : Ce fichier contient des données sensibles.
# Ne jamais committer ce fichier dans le dépôt Git.
# Copier ce fichier en .env et renseigner les valeurs.

# Environnement (development | testing | production)
CI_ENV=development

# Base de données
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=id_antique

# Clé de chiffrement (générer avec : php -r "echo bin2hex(random_bytes(32));")
ENCRYPTION_KEY=aUniqueAndSecureEncryptionKey123!@#

# URL de base du site (avec slash final)
BASE_URL=http://localhost/archive-test/
